# Copy to .env, fill in, then load it into your shell: set -a; . ./.env; set +a
# flexi never reads DATABASE_URL on purpose. Use FLEXI_DATABASE_URL.

# Stores: comma-separated keys you choose, one token per key (Shoptet admin > Connections > Private API)
FLEXI_STORES=sk
SHOPTET_TOKEN_SK=
SHOPTET_STORE_SK_URL=https://shop.example

# Optional: source of truth when you run several stores
# FLEXI_PRIMARY_STORE=sk

# Postgres for the mirror and modules (not needed for live-only MCP use)
FLEXI_DATABASE_URL=postgres://flexi:change-me@localhost:5432/flexi

# Slack incoming webhooks per channel. Missing = messages go to the log.
# FLEXI_SLACK_WEBHOOK_ALERTS=
# FLEXI_SLACK_WEBHOOK_ORDERS=
# FLEXI_SLACK_WEBHOOK_PRODUCTS=

# FLEXI_TIMEZONE=Europe/Prague
# FLEXI_MODULES=mirror,stuck-orders,merchant-feed

# MCP server (stdio): scopes for this process
# FLEXI_MCP_SCOPES=data:read,shoptet:read
# MCP server (HTTP / shared access): dedicated reader logins from `flexi-mcp db-roles`
# FLEXI_MCP_DATABASE_URL=postgres://flexi_mcp_reader:<password>@localhost:5432/flexi
# FLEXI_MCP_CUSTOMERS_DATABASE_URL=postgres://flexi_mcp_reader_customers:<password>@localhost:5432/flexi
# FLEXI_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# FLEXI_MCP_ENABLE_WRITES=false
