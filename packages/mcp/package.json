{
  "name": "@flexity/mcp",
  "version": "0.1.0",
  "description": "MCP server for Shoptet stores: live Shoptet tools, scoped read-only SQL over the local mirror, audit log and API tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "flexi-mcp": "./src/bin.ts"
  },
  "files": [
    "src",
    "migrations",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "shoptet",
    "claude"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flexity/cli": "0.1.0",
    "@flexity/core": "0.1.0",
    "@flexity/shoptet": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "^12.0.2",
    "zod": "^3.25.76"
  }
}
